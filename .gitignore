desktop/src-tauri/icons.bak-*/

# Python 本地测试缓存。
__pycache__/
.pytest_cache/

# os / 编辑器
.DS_Store
*.log

# Claude Code 的本地设置（按约定不入库）
.claude/settings.local.json

# 内部文档与历史备份，不随公开仓库分发。
private/


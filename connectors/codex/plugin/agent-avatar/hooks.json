{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 ${PLUGIN_ROOT}/scripts/agent-avatar-hook.py ; exit 0"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 ${PLUGIN_ROOT}/scripts/agent-avatar-hook.py ; exit 0"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
